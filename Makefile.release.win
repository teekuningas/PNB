IDIR = -I./src/core -I./src/game -I./src/game/actions_pure -I./src/game/ai_pure -I./src/game/rules_pure -I./src/include -I./external -I./src/menu -I./src/cup -I./src/physics -I./src/renderer
CC = gcc
CFLAGS = $(IDIR) -I/mingw64/include -O2 -Wall
LDFLAGS = -L/mingw64/lib -lglfw3 -lglew32 -lmxml -lopengl32 -lglu32
ODIR = obj

include objects.mk
_OBJ = core/main.o $(_OBJ_COMMON)
OBJ = $(patsubst %,$(ODIR)/%,$(_OBJ))

$(ODIR)/%.o: src/%.c
	mkdir -p $(@D)
	$(CC) -c -o $@ $< $(CFLAGS)

PNB.exe: $(OBJ)
	$(CC) $^ -o $@ $(LDFLAGS)
